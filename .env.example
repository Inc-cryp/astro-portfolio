# URL of the Strapi instance that serves the `posts` and `projects`
# collections. Leave this unset and the site is built from the local content
# files in src/data instead.
#
# PUBLIC_ variables are inlined into the client bundle, so only ever put a
# non-secret base URL here.
PUBLIC_STRAPI_URL=

# Origin used for canonical URLs and the generated sitemap.
# Defaults to the production deployment when unset.
SITE_URL=
