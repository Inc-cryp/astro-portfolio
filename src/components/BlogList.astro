---
import BlogCard from "@/components/BlogCard.astro";
import { getPosts } from "@/lib/content";

// Derived from the same source that generates /blog/[slug] routes, so a card
// can never link to a page that was not pre-rendered.
//
// `limit` lets the homepage show a preview without hardcoding links that the
// blog route might not generate.
const { limit } = Astro.props as { limit?: number };

const posts = await getPosts();
const visible = typeof limit === "number" ? posts.slice(0, limit) : posts;
---

{
    posts.length === 0 ? (
        <p class="text-center text-gray-500 py-16">
            No posts yet. Check back soon ✍️
        </p>
    ) : (
        <div class="grid gap-6 sm:grid-cols-2">
            {visible.map((post) => (
                <BlogCard
                    title={post.title}
                    excerpt={post.excerpt}
                    date={post.date}
                    href={`/blog/${post.slug}`}
                />
            ))}
        </div>
    )
}
