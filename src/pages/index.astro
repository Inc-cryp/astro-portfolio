---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import TechStack from "../components/TechStack.astro";
import BlogList from "../components/BlogList.astro";
import { seo } from "../lib/seo";

const meta = seo({
  title: "Fazri — Developer Portfolio",
  description:
    "Backend-focused developer building fast, scalable web applications",
});
---

<BaseLayout>
  <Fragment slot="head">
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
  </Fragment>
  <h1 class="sr-only">Fazri — Developer Portfolio</h1>
  <Hero />

  <Section title="Tech Stack">
    <TechStack />
  </Section>

  <Section title="Blog" class="mt-16 sm:mt-20">
    <p class="max-w-xl text-gray-600 dark:text-gray-400 mb-8">
      Notes and thoughts on software engineering, backend systems, and modern
      web development.
    </p>
    <BlogList limit={2} />
    <div class="mt-8">
      <a
        href="/blog"
        class="text-sm font-medium text-gray-900 dark:text-white hover:underline"
        >View all posts →</a
      >
    </div>
  </Section>
</BaseLayout>
